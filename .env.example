# Telegram — @BotFather'dan alınır
TELEGRAM_TOKEN=

# Yerel geliştirmede webhook secret doğrulamasını atlamak için
APP_ENV=development

# Üretimde webhook kaydı için (ARCHITECTURE.md §13 Aşama 0)
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# LLM sağlayıcı: openai (varsayılan) | ollama
MODEL_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
# Reasoning modelleri (gpt-5.x gibi) tool'larla /v1/chat/completions üzerinde
# reasoning_effort'u zorunlu "none" ister, aksi halde 400 hatası verir. Boş
# bırakılırsa gönderilmez (gpt-4o-mini gibi modellerde gerekmiyor).
OPENAI_REASONING_EFFORT=

# --- Ollama (MODEL_PROVIDER=ollama iken kullanılır, bkz. AGENTS.md §8) ---
OLLAMA_MODEL_ID=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434
