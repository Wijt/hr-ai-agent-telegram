# Telegram — @BotFather'dan alınır
TELEGRAM_TOKEN=

# Yerel geliştirmede webhook secret doğrulamasını atlamak için
APP_ENV=development

# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# LLM sağlayıcı: openai (varsayılan) | ollama | lmstudio
MODEL_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none 

# --- Ollama (MODEL_PROVIDER=ollama iken kullanılır) ---
OLLAMA_MODEL_ID=gemma4:26b
OLLAMA_BASE_URL=http://localhost:11434

# Context penceresi (token). Ollama'nın varsayılanı 4096'dır ve bu botun tek turluk
# prompt'una (talimatlar + tool şemaları + CV/SWOT JSON'ları + geçmiş) YETMEZ:
# Ollama prompt'u baştan kırpar, modele yazacak yer kalmaz ve cevap hata vermeden
# cümle ortasında kesilir. 16384 canlı testte doğrulandı. VRAM elverirse artırın.
# Boş bırakılırsa hiç gönderilmez, Ollama sunucusunun kendi ayarı geçerli olur.
OLLAMA_NUM_CTX=16384

# --- LM Studio (MODEL_PROVIDER=lmstudio iken kullanılır) ---
# Model adı LM Studio'daki yüklü model kimliğidir (Developer sekmesinde görünür).
# Sunucunun açık ve modelin YÜKLÜ olması gerekir. Context uzunluğu buradan değil,
# LM Studio'da model yüklenirken ayarlanır — bu yüzden NUM_CTX karşılığı yoktur.
LMSTUDIO_MODEL_ID=gemma4:26b
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

